# Copy this file to .env and add your real key before starting the backend.
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
CODEKNIGHT_LLM_ENABLED=true
CODEKNIGHT_LLM_PROVIDER=qwen_compatible_chat
CODEKNIGHT_LLM_API_URL=https://router.huggingface.co/v1/chat/completions
CODEKNIGHT_LLM_TIMEOUT_SECONDS=10
CODEKNIGHT_LLM_MAX_HINTS=2
CODEKNIGHT_LLM_FALLBACK_MODELS=Qwen/Qwen2.5-32B-Instruct,Qwen/Qwen2.5-14B-Instruct
